#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");
const net = require("net");
const { spawn } = require("child_process");

function printHelp() {
  const helpText = `logviewer - view a logfile in a browser\n\nUsage:\n  logviewer [options] <logfile> [logfile ...]\n\nOptions:\n  --wrap                 Wrap long lines\n  --no-wrap              Do not wrap long lines (default)\n  --line-numbers         Show line numbers in the UI\n  --no-line-numbers      Hide line numbers (default)\n  --charset <name>       Charset for decoding (e.g., utf-8, windows-1252)\n  -v, --verbose          Log all web requests and exceptions\n  -h, --help, -?         Show this help\n`;
  process.stdout.write(helpText);
}

function isHelpArg(arg) {
  return arg === "-h" || arg === "--help" || arg === "-?";
}

function parseArgs(argv) {
  const args = argv.slice(2);
  if (args.length === 0 || args.some(isHelpArg)) {
    return { help: true };
  }

  let wrap = false;
  let verbose = false;
  let charset = null;
  let lineNumbers = false;
  const filePaths = [];

  for (let i = 0; i < args.length; i += 1) {
    const arg = args[i];
    if (arg === "--wrap") {
      wrap = true;
    } else if (arg === "--no-wrap") {
      wrap = false;
    } else if (arg === "-v" || arg === "--verbose") {
      verbose = true;
    } else if (arg === "--line-numbers") {
      lineNumbers = true;
    } else if (arg === "--no-line-numbers") {
      lineNumbers = false;
    } else if (arg === "--charset") {
      const value = args[i + 1];
      if (!value) {
        return { error: "Missing value for --charset" };
      }
      charset = value;
      i += 1;
    } else if (arg.startsWith("--charset=")) {
      charset = arg.slice("--charset=".length);
    } else if (arg.startsWith("-")) {
      return { error: `Unexpected argument: ${arg}` };
    } else {
      filePaths.push(arg);
    }
  }

  if (filePaths.length === 0) {
    return { error: "Missing logfile path" };
  }

  return { filePaths, wrap, verbose, charset, lineNumbers };
}

function fileExists(filePath) {
  try {
    return fs.statSync(filePath).isFile();
  } catch (err) {
    return false;
  }
}

function pickPort(startPort, range) {
  return new Promise((resolve, reject) => {
    let index = 0;

    const tryNext = () => {
      if (index >= range) {
        reject(new Error("No free port found"));
        return;
      }

      const port = startPort + index;
      index += 1;
      const server = net.createServer();
      server.unref();
      server.on("error", () => {
        tryNext();
      });
      server.listen(port, "127.0.0.1", () => {
        const selected = server.address().port;
        server.close(() => resolve(selected));
      });
    };

    tryNext();
  });
}

async function main() {
  const parsed = parseArgs(process.argv);
  if (parsed.help) {
    printHelp();
    return;
  }
  if (parsed.error) {
    process.stderr.write(`${parsed.error}\n\n`);
    printHelp();
    process.exit(1);
  }

  const absoluteFilePaths = parsed.filePaths.map((filePath) =>
    path.resolve(process.cwd(), filePath)
  );
  for (const filePath of absoluteFilePaths) {
    if (!fileExists(filePath)) {
      process.stderr.write(`Logfile not found: ${filePath}\n`);
      process.exit(1);
    }
  }

  const scriptPath = fs.realpathSync(__filename);
  const scriptDir = path.dirname(scriptPath);
  const serverRoot = path.resolve(scriptDir, "..", "server");
  const serverPath = path.join(serverRoot, "js", "server.js");

  if (!fileExists(serverPath)) {
    process.stderr.write(`Server entry not found: ${serverPath}\n`);
    process.exit(1);
  }

  const port = await pickPort(3200, 200);
  const serverModule = require(serverPath);
  const server = await serverModule.start({
    port,
    filePaths: absoluteFilePaths,
    wrap: parsed.wrap,
    verbose: parsed.verbose,
    charset: parsed.charset,
    lineNumbers: parsed.lineNumbers,
  });

  const url = `http://127.0.0.1:${port}/`;
  const served = absoluteFilePaths.length === 1 ? absoluteFilePaths[0] : "multiple files";
  process.stdout.write(`Serving ${served}\n${url}\n`);

  if (process.platform === "darwin") {
    setTimeout(() => {
      const child = spawn("open", [url], { stdio: "ignore" });
      child.on("error", () => {
        process.stderr.write("Failed to open browser.\n");
      });
    }, 2000);
  }

  const shutdown = () => {
    server.close(() => {
      process.exit(0);
    });
  };

  process.on("SIGINT", shutdown);
  process.on("SIGTERM", shutdown);
}

main().catch((err) => {
  process.stderr.write(`${err.message}\n`);
  process.exit(1);
});
